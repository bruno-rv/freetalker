<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="FreeTalker Terminology">
    <suite name="FreeTalker Suite" code="FrTk" description="Automation commands for FreeTalker. This command is refused with an error unless Automation is turned on in FreeTalker's Settings &gt; Privacy.">

        <command name="clean up" code="FrTkclup" description="Post-process text with one of FreeTalker's own Templates and return the result. No microphone, no recording, no permissions. Always runs on-device (Apple's Foundation Models) — never your configured cloud provider, regardless of what's set for interactive dictation, so your API key is never read and no cloud endpoint is ever contacted by this command. This command exposes no cloud-only capability (for example, no output-language parameter), so every request it accepts can always be completed on-device. Exactly one clean up request may be in flight at a time; a concurrent call is refused as busy.">
            <cocoa class="FreeTalker.CleanUpTextCommand"/>
            <direct-parameter type="text" description="The text to clean up. Must be non-empty and under FreeTalker's size limit."/>
            <parameter name="using template" code="tmpl" type="text" description="The exact name of an existing FreeTalker Template (Settings &gt; Templates). An unknown name is an error, never a silently substituted default. If more than one Template shares this exact name, the command is refused as ambiguous rather than guessing which one to run — rename one of the colliding Templates in Settings &gt; Templates and try again. The chosen Template's prompt is exposed to whatever text is passed in — treat every enabled Template's prompt as readable by any automation caller.">
                <cocoa key="templateName"/>
            </parameter>
            <result type="text" description="The processed text."/>
        </command>

    </suite>
</dictionary>
