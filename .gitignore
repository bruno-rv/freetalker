.build/
.swiftpm/
FreeTalker.app/
.DS_Store
.worktrees/
# Machine-local stable signing identity (see scripts/make-signing-cert.sh, README) — the
# private key backing it never leaves this machine, so this file can't either.
/.codesign-identity
# scripts/release.sh build output (signed zip, checksum, manifest, signature) — regenerated
# per release, never committed.
/dist/
# Release-signing private key (scripts/make-release-signing-key.sh). Lives outside this repo by
# default (~/.freetalker/) — this is defense in depth in case a copy ever lands inside a
# checkout by mistake. Never commit it; only the public half (keys/release-public-key.base64)
# is tracked.
*.pem
# GENERATED by scripts/generate-update-public-key.sh (Plugins/GenerateUpdatePublicKey) from
# keys/release-public-key.base64 on every build — never written here in normal use (the plugin
# writes it into .build/, already ignored above), but ignored defensively in case anything ever
# writes a copy to this path by habit. Never hand-edit or commit it; edit
# keys/release-public-key.base64 instead.
/Sources/FreeTalker/Update/UpdatePublicKey.swift
/.superpowers/sdd/
.codex/sdd/features/
graphify-out/
# Agent working-session heartbeat log — never committed, regenerated per session.
.build-progress.log
